{
  "expo": {
    "scheme": "acme",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-ios-webgpu",
      "expo-asset",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "name": "WebGPUSample",
    "slug": "WebGPUSample",
    "android": {
      "package": "com.wa2goose.WebGPUSample"
    },
    "ios": {
      "bundleIdentifier": "com.wa2goose.WebGPUSample"
    }
  }
}
