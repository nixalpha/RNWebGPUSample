{
  "main": "expo-router/entry",
  "scripts": {
    "generate:shaders": "node scripts/generate-shaders.mjs",
    "generate:demo": "node scripts/generate-demo.mjs",
    "prepare:assets": "npm run generate:shaders && npm run generate:demo",
    "prestart": "npm run prepare:assets",
    "preandroid": "npm run prepare:assets",
    "preios": "npm run prepare:assets",
    "preweb": "npm run prepare:assets",
    "predeploy": "npm run prepare:assets",
    "eas-build-post-install": "npm run prepare:assets",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "preios:device": "npm run prepare:assets",
    "ios:device": "expo run:ios --device",
    "ios:prebuild": "npm run prepare:assets && expo prebuild --platform ios --no-install --skip-dependency-update react,react-native",
    "ios:pods": "cd ios && pod install",
    "web": "expo start --web",
    "deploy": "npx expo export -p web && npx eas-cli@latest deploy"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "expo": "^57.0.23",
    "expo-asset": "~57.0.17",
    "expo-build-properties": "~57.0.20",
    "expo-constants": "~57.0.18",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "gl-matrix": "^3.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-webgpu": "^0.10.2",
    "react-native-worklets": "0.10.1",
    "three": "0.172.0",
    "wgpu-matrix": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "@types/three": "0.172.0",
    "typescript": "~6.0.3"
  },
  "name": "webgpusample",
  "version": "1.0.0",
  "private": true
}
