{
  "main": "expo-router/entry",
  "scripts": {
    "generate:shaders": "node scripts/generate-shaders.mjs",
    "generate:demo": "node scripts/generate-demo.mjs",
    "prepare:assets": "npm run generate:shaders && npm run generate:demo",
    "prestart": "npm run prepare:assets",
    "preandroid": "npm run prepare:assets",
    "preios": "npm run prepare:assets",
    "preweb": "npm run prepare:assets",
    "predeploy": "npm run prepare:assets",
    "eas-build-post-install": "npm run prepare:assets",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "preios:device": "npm run prepare:assets",
    "ios:device": "expo run:ios --device",
    "ios:prebuild": "npm run prepare:assets && expo prebuild --platform ios --no-install --skip-dependency-update react,react-native",
    "ios:pods": "cd ios && pod install",
    "web": "expo start --web",
    "deploy": "npx expo export -p web && npx eas-cli@latest deploy"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "expo": "^54.0.1",
    "expo-asset": "~12.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-constants": "~18.0.8",
    "expo-linking": "~8.0.7",
    "expo-router": "~6.0.0",
    "expo-splash-screen": "~31.0.8",
    "expo-status-bar": "~3.0.7",
    "gl-matrix": "^3.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-wgpu": "0.4.2",
    "react-native-worklets": "0.5.1",
    "three": "0.172.0",
    "wgpu-matrix": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/three": "0.172.0",
    "typescript": "~5.9.2"
  },
  "name": "webgpusample",
  "version": "1.0.0",
  "private": true
}
